# Paths are resolved from the integrations/douyin working directory.
DOUYIN_STORAGE_STATE=storage-state.json
HEADLESS=true
TRACE=false

# Use the same home directory and CLI installation as your OpenClaw gateway.
OPENCLAW_BIN=openclaw
OPENCLAW_HOME=${HOME}

# Optional: use a shared Playwright browser installation.
# PLAYWRIGHT_BROWSERS_PATH=/opt/playwright-browsers
